From c3bf6dda510c9f73357bd2385b31896e0f164f10 Mon Sep 17 00:00:00 2001
From: zhaoqing412 <zhaoqing412@qq.com>
Date: Mon, 10 Aug 2026 11:52:04 +0800
Subject: [PATCH 1/5] xaga: built-in XAGR ring writer, armed at setup_arch
 head, mirrors printk

The xaga-marker-writer module (vendor ramdisk, modules.load first) never
wrote the XAGR ring on device - never confirmed loaded. Replace it with a
built-in writer so the ring is armed before anything else can go wrong:

- drivers/misc/xaga-marker-writer.c (CONFIG_XAGA_MARKER_WRITER=y, set by
  the xaga defconfig fragment only): early_ioremap()s the log_store
  reserved region (0x7ffbf000, survives the AP watchdog reboot in DRAM)
  from the head of arm64 setup_arch - the earliest point the MMU fixmap
  maps it (before paging_init the region has no mapping at all) - and
  resets magic/cursor/total/stage.
- kernel/printk/printk.c: vprintk_emit() mirrors every printk() into the
  ring (va_copy + vscnprintf, no locks/alloc, safe in any printk context),
  so whatever the kernel prints from setup_arch on is the ring tail left
  behind by a boot hang. The legacy early_printk() path is dead on arm64
  (no CONFIG_EARLY_PRINTK Kconfig, early_console never set), so the
  vprintk_emit hook is the real early-print stream.
- module-load notifier kept: a hang in a vendor module probe still leaves
  that module's name as the last ring entry.

Read back by the xaga-marker reader in the lineage_xaga kernel on the
next boot.
---
 arch/arm64/kernel/setup.c         |   5 +
 drivers/misc/Kconfig              |  16 +++
 drivers/misc/Makefile             |   1 +
 drivers/misc/xaga-marker-writer.c | 161 ++++++++++++++++++++++++++++++
 include/linux/xaga_marker.h       |  18 ++++
 kernel/printk/printk.c            |   5 +
 6 files changed, 206 insertions(+)
 create mode 100644 drivers/misc/xaga-marker-writer.c
 create mode 100644 include/linux/xaga_marker.h

diff --git a/arch/arm64/kernel/setup.c b/arch/arm64/kernel/setup.c
index 87f61fd67..0d5301fd1 100644
--- a/arch/arm64/kernel/setup.c
+++ b/arch/arm64/kernel/setup.c
@@ -32,6 +32,7 @@
 #include <linux/sched/task.h>
 #include <linux/scs.h>
 #include <linux/mm.h>
+#include <linux/xaga_marker.h>
 
 #include <asm/acpi.h>
 #include <asm/fixmap.h>
@@ -290,6 +291,10 @@ void __init __no_sanitize_address setup_arch(char **cmdline_p)
 	early_fixmap_init();
 	early_ioremap_init();
 
+	/* Earliest point the fixmap maps the xaga log_store ring (0x7ffbf000);
+	 * from here on every printk() is mirrored into it. */
+	xaga_marker_early_init();
+
 	setup_machine_fdt(__fdt_pointer);
 
 	/*
diff --git a/drivers/misc/Kconfig b/drivers/misc/Kconfig
index 5018db96c..52e3cd8ff 100644
--- a/drivers/misc/Kconfig
+++ b/drivers/misc/Kconfig
@@ -645,4 +645,20 @@ source "drivers/misc/uacce/Kconfig"
 source "drivers/misc/pvpanic/Kconfig"
 source "drivers/misc/mchp_pci1xxxx/Kconfig"
 source "drivers/misc/keba/Kconfig"
+
+config XAGA_MARKER_WRITER
+	bool "xaga boot-stage marker writer (XAGR ring)"
+	depends on ARM64
+	help
+	  xaga (Redmi Note 11T Pro / POCO X4 GT / Redmi K50i, MT6895) boot
+	  trace writer. Armed at the head of arm64 setup_arch (the earliest
+	  point the MMU maps the region) and mirrors every printk() into a
+	  circular XAGR ring in the log_store reserved DRAM region
+	  (0x7ffbf000), which survives an AP watchdog reboot and is dumped by
+	  the xaga-marker reader in the lineage_xaga kernel on the next boot,
+	  so a boot hang can be located even when the kernel dies before any
+	  console is up.
+
+	  Only the xaga defconfig fragment enables this; leave it off for
+	  other devices.
 endmenu
